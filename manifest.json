{
  "manifest_version": 3,
  "name": "Read Aloud Focus",
  "version": "1.0",
  "description": "Study by reading aloud. Advances sentence by sentence as you speak; nudges you back if you drift.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Read Aloud Focus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "naver",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
